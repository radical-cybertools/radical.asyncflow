+    await backend.build_task(_exe())
+    (kind, (template,)) = backend.batch.calls[0]
+    assert kind == "process"
+    assert template.target == sys.executable
+    assert template.args == (*_launcher_args(backend, "t1"), "/bin/echo", "hi", 3)
+    reg = backend._task_registry["t1"]
