+    gpu = _sampler(nvml)
+    gpu.start()
+    time.sleep(0.1)
+    gpu.stop()
+    assert not gpu.is_alive()
+    assert gpu.samples >= 2
+    assert gpu.peak == {"GPU-0": MIB}
