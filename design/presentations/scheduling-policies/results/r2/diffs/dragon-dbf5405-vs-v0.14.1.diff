+class TestClientPriorityLogic(unittest.TestCase):
+    """Experimental client priority: it orders ready tasks before the HEFT weight."""
+
+    class _FakeCore:
+        def __init__(self, tuid, weight=1, topo=0, priority=None):
+            self.tuid = tuid
+            self.weight = weight
+            self.heft_topo_order = topo
+            if priority is not None:
+                self.priority = priority
+
+    def test_default_priority_keeps_heft_order(self):
+        cores = [self._FakeCore("1-2", weight=1, topo=1), self._FakeCore("1-1", weight=3, topo=0)]
+        self.assertEqual([c.tuid for c in sorted(cores, key=_task_heft_priority_key)], ["1-1", "1-2"])
+
+    def test_priority_comes_before_weight_and_order(self):
+        low = self._FakeCore("1-1", weight=5, topo=0, priority=0)
+        high = self._FakeCore("1-2", weight=1, topo=7, priority=3)
+        self.assertEqual(sorted([low, high], key=_task_heft_priority_key)[0], high)
+
+    def test_core_without_priority_attribute_counts_as_zero(self):
+        old = self._FakeCore("1-1")
+        new = self._FakeCore("1-2", priority=0)
+        self.assertEqual(_task_heft_priority_key(old)[0], _task_heft_priority_key(new)[0])
+
+    def test_task_options_priority_defaults_to_zero(self):
+        self.assertEqual(BatchTaskOptions().priority, 0)
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)
