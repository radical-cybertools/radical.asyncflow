diff --git a/tests/unit/test_backend_execution_dragon_priority.py b/tests/unit/test_backend_execution_dragon_priority.py
new file mode 100644
index 0000000..ac55516
--- /dev/null
+++ b/tests/unit/test_backend_execution_dragon_priority.py
@@ -0,0 +1,127 @@
+"""DragonExecutionBackend passes task priorities to Batch and can compile each task on its own.
+
+These tests swap Batch, Node, System and Dragon's batch module for fakes, so they run where Dragon
+is absent.
+"""
+
+import asyncio
+import types
+from unittest.mock import patch
+
+import pytest
+
+from rhapsody.backends.execution import dragon as dragon_module
+from rhapsody.backends.execution.dragon import DragonExecutionBackend
+
+
+class FakeNode:
+    def __init__(self, h_uid):
+        self.hostname = h_uid
+        self.num_cpus = 8
+        self.cpus = list(range(8))
+
+
+class FakeSystem:
+    nodes = ["n0"]
+
+
+class FakeTask:
+    def __init__(self, uid):
+        self.uid = uid
+
+
+class FakeOptions:
+    def __init__(self, batch, kwargs):
+        self.batch, self.kwargs = batch, kwargs
+
+    def function(self, target, *args, **kwargs):
+        self.batch.submitted.append(self.kwargs)
+        return FakeTask(f"t{len(self.batch.submitted)}")
+
+
+class FakeBatch:
+    """A Batch whose options() takes a priority, like the experimental Dragon branch."""
+
+    def __init__(self, **kwargs):
+        self.num_workers, self.num_managers = 4, 2
+        self.submitted = []
+
+    def options(self, name=None, timeout=None, stdout=None, stderr=None, priority=0):
+        return FakeOptions(self, {"name": name, "priority": priority})
+
+    def join(self, timeout=None):
+        pass
+
+    def destroy(self, timeout=None):
+        pass
+
+    def log_dir(self):
+        raise RuntimeError("no task logs")
+
+
+class FakeBatchWithoutPriority(FakeBatch):
+    """A Batch as in dragonhpc 0.14.1: options() has no priority."""
+
+    def options(self, name=None, timeout=None, stdout=None, stderr=None):
+        return FakeOptions(self, {"name": name})
+
+
+def _drain(first, q, item_type, linger_sec=0.005, max_batch_size=256):
+    return [first], None
+
+
+@pytest.fixture
+def fake_batch_module():
+    module = types.SimpleNamespace(_drain_client_task_batch=_drain)
+    _drain.__defaults__ = (0.005, 256)
+    with patch.multiple(
+        dragon_module, Node=FakeNode, System=FakeSystem, dragon_batch_module=module
+    ):
+        yield module
+    _drain.__defaults__ = (0.005, 256)
+
+
+def _function_task(uid, **extra):
+    return {"uid": uid, "name": uid, "function": lambda: 0, "args": [], "kwargs": {}, **extra}
+
+
+def test_priority_reaches_batch_options(fake_batch_module):
+    with patch.object(dragon_module, "Batch", FakeBatch):
+        backend = DragonExecutionBackend()
+        asyncio.run(backend.build_task(_function_task("a", priority=7)))
+        asyncio.run(backend.build_task(_function_task("b")))
+    assert backend.batch.submitted == [{"name": "a", "priority": 7}, {"name": "b", "priority": 0}]
+
+
+def test_priority_ignored_when_batch_cannot_take_it(fake_batch_module):
+    with patch.object(dragon_module, "Batch", FakeBatchWithoutPriority):
+        backend = DragonExecutionBackend()
+        asyncio.run(backend.build_task(_function_task("a", priority=7)))
+    assert backend.batch.submitted == [{"name": "a"}]
+
+
+def test_compile_each_task_sets_and_restores_client_grouping(fake_batch_module):
+    with patch.object(dragon_module, "Batch", FakeBatch):
+        backend = DragonExecutionBackend(compile_each_task=True)
+        assert fake_batch_module._drain_client_task_batch.__defaults__ == (0.0, 1)
+        asyncio.run(backend.shutdown())
+    assert fake_batch_module._drain_client_task_batch.__defaults__ == (0.005, 256)
+
+
+def test_client_grouping_untouched_by_default(fake_batch_module):
+    with patch.object(dragon_module, "Batch", FakeBatch):
+        DragonExecutionBackend()
+    assert fake_batch_module._drain_client_task_batch.__defaults__ == (0.005, 256)
+
+
+def test_compile_each_task_without_grouping_function_warns(caplog):
+    with patch.multiple(
+        dragon_module,
+        Node=FakeNode,
+        System=FakeSystem,
+        Batch=FakeBatch,
+        dragon_batch_module=types.SimpleNamespace(),
+    ):
+        backend = DragonExecutionBackend(compile_each_task=True)
+    assert backend._saved_client_grouping is None
+    assert "compile_each_task ignored" in caplog.text
