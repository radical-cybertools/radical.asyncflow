+def _set_client_grouping(defaults: tuple, logger: logging.Logger) -> Optional[tuple]:
+    """Set the (linger_sec, max_batch_size) defaults of Batch's client grouping.
+
+    Dragon 0.14.1's Batch client compiles submissions that arrive within 5 ms of each other
+    (up to 256) together, and reports their completions only when all of them are done.
+    ``_drain_client_task_batch`` is called without those arguments, so its defaults decide.
+    Returns the previous defaults, or None when this Dragon has no such function.
+    """
+    fn = getattr(dragon_batch_module, "_drain_client_task_batch", None)
+    old = getattr(fn, "__defaults__", None)
+    if fn is None or old is None or len(old) != 2:
+        logger.warning(
+            "This Dragon has no Batch client grouping to change; compile_each_task ignored"
+        )
+        return None
+    fn.__defaults__ = defaults
+    return old
+
+
