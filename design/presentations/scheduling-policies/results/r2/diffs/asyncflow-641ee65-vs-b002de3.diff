diff --git a/tests/unit/test_policies.py b/tests/unit/test_policies.py
index fd8ecde..351ab4b 100644
--- a/tests/unit/test_policies.py
+++ b/tests/unit/test_policies.py
@@ -40,6 +40,47 @@ class _Clock:
 # ---------------------------------------------------------------------------
 
 
+class TestDispatchPriority:
+    """Experimental: set_priority writes the policy's own order into ``priority``."""
+
+    @pytest.mark.parametrize("policy", [FifoPolicy, LineagePolicy, FairPolicy])
+    def test_no_priority_by_default(self, policy):
+        p = policy(4)
+        p.enqueue("t0", _desc("t0", 0))
+        assert "priority" not in p.dispatch()[0]
+
+    def test_fifo_priority_follows_ready_order(self):
+        p = FifoPolicy(8, set_priority=True)
+        for i in range(3):
+            p.enqueue(f"t{i}", _desc(f"t{i}", i))
+        prio = [d["priority"] for d in p.dispatch()]
+        assert prio == sorted(prio, reverse=True) and len(set(prio)) == 3
+
+    def test_lineage_priority_prefers_older_lineage(self):
+        p = LineagePolicy(8, set_priority=True)
+        p.enqueue("new", _desc("new", 5))
+        p.enqueue("old", _desc("old", 6, lineage=1))
+        prio = {d["uid"]: d["priority"] for d in p.dispatch()}
+        assert prio["old"] > prio["new"]
+
+    def test_fair_priority_prefers_lower_virtual_runtime(self):
+        clock = _Clock()
+        p = FairPolicy(1, clock=clock, set_priority=True)
+        p.enqueue("b0", _desc("b0", 0, workflow_id="bulk"))
+        p.enqueue("b1", _desc("b1", 1, workflow_id="bulk"))
+        (first,) = p.dispatch()
+        clock.now = 1.0
+        p.release(first["uid"])  # bulk has now run for 1 s
+        p.enqueue("i0", _desc("i0", 2, workflow_id="interactive"))
+        p.release("none")
+        (second,) = p.dispatch()
+        assert second["uid"] == "i0"
+        assert second["priority"] >= first["priority"]
+        p.release("i0")
+        (third,) = p.dispatch()
+        assert third["uid"] == "b1" and third["priority"] < second["priority"]
+
+
